# Copy to REPOSITORY ROOT .env; chmod 600 .env. Fill empty required values.
# PUBLIC: never put a service-role key, password or provider key in NEXT_PUBLIC_*.
COMPOSE_PROJECT_NAME=genesis-talk
SINGLE_SERVER=0
REVERSE_PROXY=caddy
COMPOSE_PROFILES=
DOMAIN=crm.example.invalid
ACME_EMAIL=admin@example.invalid
NEXT_PUBLIC_APP_URL=https://crm.example.invalid
NEXT_PUBLIC_ADMIN_URL=https://crm.example.invalid
NEXT_PUBLIC_SUPABASE_URL=https://project.example.invalid
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER_SECRET: app SQL role and owner SQL role for baseline/backup (host only).
SUPABASE_DB_URL=
SUPABASE_DB_ADMIN_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SERVER_SECRET: openssl rand -hex 32; AES key: openssl rand -base64 32.
INTERNAL_SECRET=
INTERNAL_CRON_SECRET=
CPF_ENCRYPTION_KEY=
WAHA_BYO_ENCRYPTION_KEY=
AI_CRED_AES_KEY=
# SERVER_SECRET: local WAHA; SHA512 must match plaintext WAHA_API_KEY.
WAHA_API_BASE_URL=http://waha:3000
WAHA_WEBHOOK_BASE_URL=http://app:3000
WAHA_API_KEY=
WAHA_API_KEY_SHA512=
WAHA_HMAC_SECRET=
WAHA_WEBHOOK_REQUIRE_SIGNATURE=true
WHATSAPP_DEFAULT_ENGINE=NOWEB
# OPTIONAL: leave WAHA_IMAGE absent; the wrapper selects upstream's architecture pin.
# SERVER_SECRET: SRH_TOKEN and UPSTASH_REDIS_REST_TOKEN must match.
UPSTASH_REDIS_REST_URL=http://srh:80
UPSTASH_REDIS_REST_TOKEN=
SRH_TOKEN=
# ONE_TIME_SECRET: first owner, used only by --fresh; remove password after bootstrap.
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_ORG_NAME=Minha Empresa
# PUBLIC: fallback only; database white-label settings take precedence.
APP_NAME=GENESIS TALK
APP_ACCENT_HEX='#7ED321'
APP_LOCALE=pt-BR
# OPTIONAL: IA can be configured in the UI later; no paid key is mandatory.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# OPTIONAL SERVER_SECRET: SMTP, see root .env.example for additional transports.
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# OPTIONAL: telemetry requires the operator's explicit choice.
SENTRY_DSN=off
# OPTIONAL SERVER_SECRET: only with explicit COMPOSE_PROFILES=telefonia.
ARI_USERNAME=
ARI_PASSWORD=
# OPTIONAL SERVER_SECRET: only with explicit COMPOSE_PROFILES=voz.
WACALLS_ADMIN_USER=
WACALLS_ADMIN_PASSWORD=
WACALLS_API_TOKEN=
