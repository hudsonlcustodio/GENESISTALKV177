diff --git a/lib/depth-guard.js b/lib/depth-guard.js
new file mode 100644
index 0000000000000000000000000000000000000000..21feb7d610205c69db54bb150bbfd5e7948185a0
--- /dev/null
+++ b/lib/depth-guard.js
@@ -0,0 +1,17 @@
+'use strict';
+// Genesis mitigation for GHSA-vfj7-8cjw-p6xm. Fixed, non-disableable depth cap.
+// Traverse iteratively before recursive walkers, including caller-provided ASTs.
+module.exports = ast => {
+  const pending = [[ast, 0]];
+  const visited = new Set();
+  let count = 0;
+  while (pending.length) {
+    const [node, depth] = pending.pop();
+    if (depth > 128 || ++count > 100000 || visited.has(node)) {
+      throw new SyntaxError('Brace AST exceeds safe depth or contains repeated nodes');
+    }
+    if (!node || typeof node !== 'object') continue;
+    visited.add(node);
+    if (node.nodes) for (const child of node.nodes) pending.push([child, depth + 1]);
+  }
+};
